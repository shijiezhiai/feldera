# P1-018: the remote compiler image.
#
# It is the manager image plus a different service selection, and deliberately
# nothing else. Compiling a pipeline needs the manager binary, the sql2dbsp jar,
# `Cargo.lock`, the `crates/` source tree, the Rust toolchain and the offline
# cargo cache — and `deploy/Dockerfile.manager` already ships all of them,
# because it has to compile pipelines in-process when it runs every service
# itself. Rebuilding that stack here would produce two images that drift apart
# and a compiler that fails on the first crate version they disagree on.
#
# What differs is only how the same binary is invoked: the chart sets
# `FELDERA_SERVICES=compiler,artifact-server` for this pod and `api` for the API
# server pod, so compilation and artifact storage move here together (P1-018).
#
# Building (the build context must be the repository root):
#   docker build -f deploy/Dockerfile.compiler \
#     --build-arg BASE_IMAGE=localhost:5001/feldera-manager:<ver> \
#     -t feldera-compiler:<ver>-bili.N .
#
# Smoke test:
#   /home/ubuntu/feldera/build/pipeline-manager --version
#   java -version && cargo --version && pkg-config --modversion rdkafka
# Tag conventions: docs/self-hosted-images.md.
ARG BASE_IMAGE=localhost:5001/feldera-manager:latest
FROM ${BASE_IMAGE}

# The claim path the chart mounts. Creating it here means the first pod start
# does not depend on the kubelet setting up the mount before the process runs,
# and a claim-backed directory owned by `ubuntu` is what the compiler writes to.
USER root
RUN mkdir -p /home/ubuntu/.feldera/compiler && chown -R ubuntu:ubuntu /home/ubuntu/.feldera
USER ubuntu

# Fail the build, not the first compilation, if the base image stopped carrying
# what remote compilation needs. Each of these is load-bearing: the binary runs
# the service, the jar compiles SQL, Cargo.lock pins the pipeline build, and
# crates/ is the source tree that build compiles.
RUN test -x /home/ubuntu/feldera/build/pipeline-manager \
  && test -f /home/ubuntu/feldera/build/sql2dbsp-jar-with-dependencies.jar \
  && test -f /home/ubuntu/feldera/Cargo.lock \
  && test -d /home/ubuntu/feldera/crates \
  && java -version 2>/dev/null \
  && cargo --version \
  && pkg-config --modversion rdkafka >/dev/null

# The base image's ENTRYPOINT already passes --bind-address, --sql-compiler-path,
# --compilation-cargo-lock-path, --dbsp-override-path and --demos-dir; the chart
# adds the database connection string and the service selection.
CMD ["--services=compiler,artifact-server"]
