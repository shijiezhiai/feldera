<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <!-- 本网络直连 Maven Central 常中途截断(如 sqlite-jdbc 13.5M 只收到 11.7M)。
         阿里云 central 镜像完整(calcite/jackson 全版本), 作为 central 的镜像。
         (腾讯云 maven-public 部分版本未同步, 如 jackson-dataformat-csv 2.22.3 → 404) -->
    <mirror>
      <id>aliyun-central</id>
      <name>Aliyun Maven Central mirror</name>
      <url>https://maven.aliyun.com/repository/central/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
