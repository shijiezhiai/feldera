# Fast iteration overlay for the manager image.
#
# `deploy/Dockerfile.manager` compiles the manager from source, which takes
# 60-90 minutes on an arm64 laptop because the cargo target directory lives in
# the build stage and is lost whenever `crates/` changes. While iterating on
# manager code (P1-009 onwards) that cost dominates the edit/verify loop.
#
# This overlay rebuilds the image in seconds: it starts from an already-built
# manager image and replaces the binary and the sources.
#
# The sources matter: the manager does not ship a prebuilt pipeline binary.
# When it provisions a pipeline it copies `crates/` out of this image and runs
# `cargo build` in the compiler pod, so the pipeline process is compiled from
# whatever source tree the image carries. Replacing only the manager binary
# leaves the pipeline running last iteration's code, which looks like "my
# change had no effect" for anything that is not on the manager's own path.
#
# The binary must be produced for linux/<arch> with the same feature set as the
# release build:
#
#   cargo build --release --locked -p pipeline-manager --features feldera-enterprise
#
# Usage (from the repository root, after copying the binary to deploy/.build/):
#
#   docker build -f deploy/Dockerfile.manager.overlay \
#     --build-arg BASE_IMAGE=localhost:5001/feldera-manager:<ver> \
#     -t localhost:5001/feldera-manager:<ver>-bili.N .
#
# Release images are always built from `deploy/Dockerfile.manager`; this file
# only exists to keep local verification loops short.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY --chown=ubuntu deploy/.build/pipeline-manager /home/ubuntu/feldera/build/pipeline-manager

# The pipeline binary is compiled inside the compiler pod from this tree, so
# the tree has to be the one that produced the manager binary above. `Cargo.lock`
# and the manifests travel with it: a source tree whose lockfile disagrees with
# its code fails the in-pod build, and the failure surfaces as an opaque compile
# timeout rather than as a missing file.
COPY --chown=ubuntu Cargo.toml Cargo.lock /home/ubuntu/feldera/
COPY --chown=ubuntu crates/ /home/ubuntu/feldera/crates/
COPY --chown=ubuntu sql-to-dbsp-compiler/lib/ /home/ubuntu/feldera/sql-to-dbsp-compiler/lib/
COPY --chown=ubuntu sql-to-dbsp-compiler/temp/ /home/ubuntu/feldera/sql-to-dbsp-compiler/temp/

# The image's ENTRYPOINT launches the binary from this path; keep the release
# stage's executable bit explicit because COPY preserves the source mode, and a
# binary copied from a non-executable location would break the container.
RUN chmod +x /home/ubuntu/feldera/build/pipeline-manager
