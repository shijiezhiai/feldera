{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feldera platform chart values",
  "description": "Rejects a values file the platform cannot honour, so a mistake fails at render time instead of after a pipeline has been provisioned onto the wrong storage class.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "controlplane": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "description": "API server replicas. Above one, leader election picks the reconciler."
        },
        "postgresPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "kubernetesRunner": {
          "type": "object",
          "properties": {
            "enableStorageClassNamesSupported": {
              "type": "boolean"
            },
            "storageClassNamesSupported": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Classes a pipeline may name. An empty list with the switch on refuses every named class."
            },
            "storageClassName": {
              "type": [
                "string",
                "null"
              ],
              "description": "Class given to a pipeline that names none; null uses the cluster default."
            },
            "tenantNamespaces": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              },
              "description": "Tenant UUID to namespace. Each namespace must already exist."
            },
            "lowerLimitMemoryMegabyte": {
              "type": "integer",
              "minimum": 1
            },
            "upperLimitMemoryMegabyte": {
              "type": "integer",
              "minimum": 1
            },
            "defaultStorageMegabyte": {
              "type": "integer",
              "minimum": 1
            },
            "upperLimitStorageMegabyte": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "apiServerAntiAffinity": {
          "type": "string",
          "enum": [
            "preferred",
            "required",
            "none"
          ],
          "description": "How API server replicas are kept apart above one replica."
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "provider": {
              "type": "string",
              "enum": [
                "generic-oidc",
                "aws-cognito",
                "none"
              ],
              "description": "OIDC provider type the manager accepts tokens from."
            },
            "clientId": {
              "type": "string",
              "description": "OIDC application client id. The web console sends it in the authorization request and the manager checks it against the token."
            },
            "issuer": {
              "type": "string",
              "description": "OIDC issuer URL. Fetched through discovery before any token is accepted."
            },
            "cognitoLoginUrl": {
              "type": "string"
            },
            "cognitoLogoutUrl": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "comment": "Enabling authentication without a provider the manager can build turns a working deployment into a CrashLoopBackOff, so refuse it at render time.",
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "provider": {
                    "enum": [
                      "generic-oidc",
                      "aws-cognito"
                    ]
                  },
                  "clientId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "issuer": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "clientId",
                  "issuer"
                ]
              }
            }
          ]
        },
        "authorization": {
          "type": "object",
          "properties": {
            "individualTenant": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "issuerTenant": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "authorizedGroups": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "groupRoleMaps": {
              "type": [
                "object",
                "null"
              ],
              "description": "Identity-provider group name to the role it grants. Keys also admit the login. 'owner' is rejected by the manager at startup, since it is configuration-only.",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "read",
                  "write",
                  "admin"
                ]
              },
              "propertyNames": {
                "minLength": 1
              }
            },
            "authAudience": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "httpsSecretRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Name of a TLS secret (tls.crt / tls.key). Required for an HTTPS scheme that the console's OIDC redirect URIs can be registered against."
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Platform owners, never grantable at runtime. An entry matches a provider-verified email, a bare OIDC subject, or '<issuer> <subject>'."
        }
      }
    }
  }
}
